{
  "name": "@sam/api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/start.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/start.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "test": "node --import tsx --test src/**/*.test.ts",
    "prune-scans": "node --import tsx src/scripts/prune-scans.ts"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.11",
    "bwip-js": "^4.11.4",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "express": "^4.22.3",
    "helmet": "^7.2.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.20.0",
    "svg-to-pdfkit": "^0.1.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.13",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/svg-to-pdfkit": "^0.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
